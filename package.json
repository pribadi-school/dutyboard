{
  "name": "duty-board-pribadi-depok",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Teachers on Duty board for SD Pribadi Depok: TV display, week view, admin editor (React + PHP/MySQL on cPanel)",
  "scripts": {
    "dev": "vite",
    "dev:php": "vite --mode php",
    "php": "node scripts/php-dev.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "deploy": "node scripts/publish-deploy.ts",
    "typecheck": "tsc -p tsconfig.json",
    "seed:generate": "node scripts/generate-seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
